# Supabase — dari Project Settings > API di dashboard Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Google Gemini — untuk kategorisasi materi (GRATIS, tanpa kartu kredit).
# Buat kunci di https://aistudio.google.com/apikey
GOOGLE_GEMINI_API_KEY=

# Opsional: OCR untuk PDF hasil scan (berbayar setelah kuota gratis
# bulanan habis — lihat README). Kalau tidak diisi, upload PDF hasil
# scan akan gagal dengan pesan error yang jelas, tapi PDF teks biasa
# tetap berfungsi normal.
GOOGLE_CLOUD_VISION_API_KEY=

# Opsional, TIDAK dipakai secara default lagi (lihat lib/anthropic.ts).
# Proyek ini beralih ke Gemini supaya kategorisasi materi bisa gratis.
# Isi ini hanya kalau kamu sengaja mau pakai Claude lagi untuk kualitas
# kategorisasi yang lebih baik (berbayar).
ANTHROPIC_API_KEY=
